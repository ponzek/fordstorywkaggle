# Copy this file to .env and paste your private API key(s).
# Never commit .env to GitHub.
GEMINI_API_KEY=your_gemini_api_key_here
# Any generateContent-capable Gemini model works (e.g. gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3-flash-preview)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI fallback if you also have OpenAI credits:
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=auto
